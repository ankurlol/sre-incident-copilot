# ==============================================================================
# Self-Healing SRE Incident Copilot - Environment Configuration Template
# ==============================================================================

# App Configuration
APP_NAME="Self-Healing SRE Incident Copilot"
APP_ENV=production
PORT=8000
HOST=0.0.0.0

# Database Configuration
# In Production: use free Neon Serverless Postgres (pooled connection string)
# Example: postgresql://neondb_owner:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./incidents.db

# LLM Root Cause Analysis Engine (Google AI Studio Free Tier: https://aistudio.google.com)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_free_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# GitHub Actions Automated Rollbacks
# Generate a Personal Access Token (classic) with 'repo' and 'workflow' permissions
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPO_OWNER=your_org_or_username
GITHUB_REPO_NAME=target-service-repo
GITHUB_WORKFLOW_ID=deploy.yml
SIMULATE_GITHUB_ACTIONS=false

# Target Service Health Check Endpoint (polled post-rollback to verify restoration)
TARGET_SERVICE_URL=http://localhost:8000/mock-target/healthz
HEALTHCHECK_MAX_RETRIES=5
HEALTHCHECK_INTERVAL_SEC=2.0

# Safety Guardrails
AUTO_ROLLBACK_ENABLED=true
MIN_CONFIDENCE_THRESHOLD=0.75
BLOCK_ON_DB_MIGRATION=true
MAX_ROLLBACKS_PER_WINDOW=1
ROLLBACK_WINDOW_MINUTES=15

# Webhook Security Header (Optional: protect POST /api/v1/incident/alert with X-API-Key)
API_KEY=your_random_webhook_secret

# Incident Alert Webhooks (Optional: Slack or Discord incoming webhook)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Admin Portal Credentials
# - ADMIN_EMAIL: Your email address. When you log in with this email, you are granted admin privileges.
# - ADMIN_KEY: A secret passcode required on the /admin portal login card.
ADMIN_EMAIL=your_email@gmail.com
ADMIN_KEY=your_secret_admin_key

# Google OAuth (Optional - for Google Single Sign-On)
GOOGLE_CLIENT_ID=

# SMTP Email Delivery for OTP Verification (Optional)
# If empty, OTP codes are logged in server console and displayed on screen in dev mode.
# If configured, real verification emails are sent directly to recipient inboxes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
